-- ==============================================================================
-- MASTER DAX MEASURES LIBRARY - UNIVERSITETET I AGDER (UIA) CONTROLLER Cockpit
-- Forankret i:
--   1. Use Case / case data (FactGL, FactBudget, FactFTE, FactStudyPoints, FactAction, FactProjectBOA)
--   2. DFØ Statlige Regnskapsstandarder (SRS 1, 9, 10, 17, 25)
--   3. Rundskriv F-05-20 (5 %-regelen for ubrukte bevilgningsmidler)
--   4. KDs finansieringsmodell 2025 (Kategori 1: 54 550 kr, Kat 2: 81 800 kr, Kat 3: 190 900 kr)
--   5. Rullende 12-Måneders Hybridprognose (Actuals + LE) & Forecast Bias Index
--   6. TDI-modellen for BOA-prosjektcontrolling (frikjøp, direkte drift, overhead ~22 %, leiested)
-- ==============================================================================

-- ==============================================================================
-- 1. FINANS & REGNSKAP (ACCOUNTING & FINANCIAL MEASURES)
-- ==============================================================================

[Regnskap Beløp] = 
SUM ( FactGL[Belop] )
/* Format: #,##0.00 | Faktisk regnskapsført beløp (Debet / Kredit) */

[Regnskap Faktisk Beløp] = 
[Regnskap Beløp]

[Regnskap Faktisk YTD] = 
TOTALYTD ( [Regnskap Beløp], DimDate[Dato] )
/* Format: #,##0.00 | Akkumulert faktisk regnskap hittil i år */

[Budsjett Beløp] = 
CALCULATE (
    SUM ( FactBudget[BudsjettBelop] ),
    FactBudget[Scenario] = "BUD2026"
)
/* Format: #,##0.00 | Vedtatt årsbudsjett 2026 */

[Budsjett YTD] = 
TOTALYTD ( [Budsjett Beløp], DimDate[Dato] )
/* Format: #,##0.00 | Vedtatt budsjett akkumulert YTD */

[Prognose Beløp (LE)] = 
CALCULATE (
    SUM ( FactBudget[BudsjettBelop] ),
    FactBudget[Scenario] = "LE_2026"
)
/* Format: #,##0.00 | Gjeldende helårsprognose (Latest Estimate) */

[Gjeldende Prognose Beløp] = 
CALCULATE (
    SUM ( FactBudget[BudsjettBelop] ),
    FactBudget[Scenario] IN { "LE_2026", "FC2_2026", "FC1_2026" }
)
/* Format: #,##0.00 | Beløp fra seneste aktive prognoseversjon */

[Bevilgningsinntekt] = 
CALCULATE (
    -[Regnskap Beløp],
    DimAccount[SRS_regnskapslinje] = "Tilskudd og overføringer" || DimAccount[Konto] IN { 3900, 3910 }
)
/* Format: #,##0.00 | Statlig rammebevilgning (Kredit snudd til positiv inntekt) */

[Lønnskostnad] = 
CALCULATE (
    [Regnskap Beløp],
    DimAccount[SRS_regnskapslinje] = "Lonnskostnader" || DimAccount[Konto] >= 5000 && DimAccount[Konto] <= 5999
)
/* Format: #,##0.00 | Samlede lønns- og personalkostnader */

[Driftskostnader Eks Lønn] = 
CALCULATE (
    [Regnskap Beløp],
    DimAccount[Kontotype] = "Kostnad",
    DimAccount[SRS_regnskapslinje] <> "Lonnskostnader",
    DimAccount[Konto] >= 6000
)
/* Format: #,##0.00 | Vare-, drifts- og konsulentkostnader */

[Total Kostnad] = 
CALCULATE (
    [Regnskap Beløp],
    DimAccount[Kontotype] = "Kostnad" || DimAccount[Konto] >= 5000 && DimAccount[Konto] <= 7999
)
/* Format: #,##0.00 | Samlede drifts- og personalkostnader */

[Lønnsandel %] = 
DIVIDE ( [Lønnskostnad], [Total Kostnad], 0 )
/* Format: 0.0% | Lønnsandel av driftskostnader (måltall: ~70-71 %) */

[Budsjettavvik KR] = 
[Budsjett Beløp] - [Total Kostnad]
/* Format: #,##0.00 | Avvik mot budsjett (positivt = mindreforbruk / gunstig) */

[Budsjettavvik %] = 
DIVIDE ( [Budsjettavvik KR], ABS ( [Budsjett Beløp] ), 0 )
/* Format: 0.0% | Relativt budsjettavvik */


-- ==============================================================================
-- 2. RULLENDE 12-MÅNEDERS HYBRIDPROGNOSE (ROLLING FORECAST DAX)
-- ==============================================================================

[Rullende 12M Hybrid] = 
VAR SisteDatoFaktisk = CALCULATE ( MAX ( FactGL[DatoNokkel] ) )
RETURN
SUMX (
    DATESINPERIOD ( DimDate[Dato], MAX ( DimDate[Dato] ), -12, MONTH ),
    VAR MndDato = DimDate[DatoNokkel]
    RETURN
    IF (
        MndDato <= SisteDatoFaktisk,
        [Regnskap Beløp],
        [Gjeldende Prognose Beløp]
    )
)
/* Format: #,##0.00 | Kombinerer faktiske tall for passerte måneder med LE for reståret */

[Rullende 12M Avvik vs Budsjett KR] = 
[Rullende 12M Hybrid] - [Budsjett Beløp]
/* Format: #,##0.00 | Avvik mellom rullende 12M bane og vedtatt årsbudsjett */

[Rullende 12M Avvik vs Budsjett %] = 
DIVIDE ( [Rullende 12M Avvik vs Budsjett KR], ABS ( [Budsjett Beløp] ), 0 )
/* Format: 0.0% | Relativt avvik rullende 12M vs budsjett */

[Forecast Bias Index] = 
VAR TidligerePrognose = CALCULATE ( SUM ( FactBudget[BudsjettBelop] ), FactBudget[Scenario] = "FC1_2026" )
VAR FaktiskUtfall = [Regnskap Beløp]
RETURN
DIVIDE ( FaktiskUtfall - TidligerePrognose, TidligerePrognose, 0 )
/* Format: +0.0% | Måler om enheten systematisk over- eller underprognostiserer */


-- ==============================================================================
-- 3. SRS & REGELVERKSKONTROLL (COMPLIANCE & BALANCE MEASURES)
-- ==============================================================================

[Ubenyttet Rammebevilgning (2080)] = 
CALCULATE (
    ABS ( SUM ( FactGL[Belop] ) ),
    DimAccount[Konto] = 2080
)
/* Format: #,##0.00 | Akkumulert ubenyttet rammebevilgning i balansen (konto 2080) */

[Rammebevilgning Tildelt YTD] = 
CALCULATE (
    ABS ( SUM ( FactBudget[BudsjettBelop] ) ),
    DimAccount[Konto] = 3900 || FactBudget[Konto] = 3900
)
/* Format: #,##0.00 | Samlet tildelt rammebevilgning fra KD (konto 3900) */

[Avsetningsgrad % (F-05-20)] = 
DIVIDE (
    [Ubenyttet Rammebevilgning (2080)],
    [Rammebevilgning Tildelt YTD],
    0
)
/* Format: 0.00% | Andel ubrukte midler av rammen (F-05-20 grense: 5,00 %) */

[F-05-20 Risikoflagg] = 
IF (
    [Avsetningsgrad % (F-05-20)] > 0.05,
    "RØD: Risikerer inndragning (>5%)",
    "GRØNN: Innenfor regelverket"
)
/* Tekstindikator for revisjons- og styringskontroll */

[Ikke Inntektsført Bidrag (SRS 10)] = 
CALCULATE (
    SUM ( FactGL[Belop] ),
    DimAccount[Konto] = 2180
)
/* Format: #,##0.00 | Balansekonto 2180 mottatt forskuddsbetaling bidrag */

[Avsetning Tapsoppdrag (SRS 9)] = 
CALCULATE (
    SUM ( FactGL[Belop] ),
    DimAccount[Konto] = 2800
)
/* Format: #,##0.00 | Balansekonto 2800 tapsavsetning oppdragsforskning */


-- ==============================================================================
-- 4. BOA PROSJEKTCONTROLLING & TDI-KALKYLE (EXTERNAL FUNDING)
-- ==============================================================================

[BOA Totalt Kontraktsbeløp] = 
SUM ( FactProjectBOA[Kontraktsbelop] )
/* Format: #,##0.00 | Samlet ekstern kontraktverdi (NFR, EU, Oppdrag) */

[BOA Påløpt Kostnad] = 
SUM ( FactProjectBOA[PåløptKostnad] )
/* Format: #,##0.00 | Påløpte prosjektkostnader (direkte + indirekte) */

[BOA Inntektsført Beløp (SRS 10)] = 
SUM ( FactProjectBOA[Inntektsført] )
/* Format: #,##0.00 | Inntektsført i virksomhetsregnskapet */

[BOA Frikjøp Inntekt] = 
CALCULATE (
    [Regnskap Beløp],
    DimProject[Finansieringstype] IN { "Bidrag", "Oppdrag" },
    DimAccount[Konto] = 5000
)
/* Format: #,##0.00 | Frikjøp av fast vitenskapelig ansattes tid til eksterne prosjekter */

[BOA Overhead Dekning %] = 
AVERAGE ( FactProjectBOA[Dekningsgrad] )
/* Format: 0.0% | Gjennomsnittlig indirekte kostnadsdekning (~22-25 %) */

[BOA Forbruksavvik %] = 
AVERAGE ( FactProjectBOA[%BudsjettForbrukt] ) - AVERAGE ( FactProjectBOA[%TidGått] )
/* Format: +0.0%;-0.0% | Forbruksavvik (% Budsjett - % Tid) */

[BOA RAG Status] = 
VAR Avvik = [BOA Forbruksavvik %]
RETURN
SWITCH (
    TRUE (),
    Avvik > 0.15, "RØD: Betydelig merforbruk",
    Avvik < -0.20, "GUL: Betydelig fremdriftsforsinkelse",
    "GRØNN: I rute"
)
/* RAG status basert på TDI-kalkylens fremdrift og budsjettforbruk */


-- ==============================================================================
-- 5. ÅRSVERK & BEMANNINGSKONTROLL (FTE & WORKFORCE)
-- ==============================================================================

[Faktiske Årsverk] = 
CALCULATE (
    SUM ( FactFTE[Aarsverk] ),
    FactFTE[Scenario] = "Actual"
)
/* Format: #,##0.0 | Faktisk bemanning i utførte årsverk */

[Budsjetterte Årsverk] = 
CALCULATE (
    SUM ( FactFTE[Aarsverk] ),
    FactFTE[Scenario] = "BUD2026" || FactFTE[Scenario] = "Budget"
)
/* Format: #,##0.0 | Budsjettert bemanningsramme */

[Vakanser Årsverk] = 
[Budsjetterte Årsverk] - [Faktiske Årsverk]
/* Format: #,##0.0 | Årsverksavvik / ubesatte stillinger */

[Snitt Lønn per Årsverk] = 
DIVIDE ( [Lønnskostnad], [Faktiske Årsverk], 0 )
/* Format: #,##0 kr | Gjennomsnittlig lønns- og personalkostnad per FTE */


-- ==============================================================================
-- 6. UTDANNING & KDS FINANSIERINGSMODELL 2025 (KD FUNDING & SPE60)
-- ==============================================================================

[Totalt Avlagte Studiepoeng] = 
SUM ( FactStudyPoints[AvlagteStudiepoeng] )
/* Format: #,##0 | Samlet antall avlagte ECTS studiepoeng */

[Totalt SPE60] = 
SUM ( FactStudyPoints[SPE60] )
/* Format: #,##0.0 | 60-studiepoengsekvivalenter avlagt */

[Gjennomsnittlig Beståttandel %] = 
AVERAGE ( FactStudyPoints[BestattAndel] )
/* Format: 0.0% | Eksamensgjennomføring og beståttgrad */

[KDs Beregnede BFE-Inntekt] = 
SUMX (
    FactStudyPoints,
    FactStudyPoints[SPE60] * 
    SWITCH (
        FactStudyPoints[Studiekategori],
        "Kategori 1", 54550,
        "Kat1", 54550,
        "Kategori 2", 81800,
        "Kat2", 81800,
        "Kategori 3", 190900,
        "Kat3", 190900,
        FactStudyPoints[SatsPerSPE60]
    )
)
/* Format: #,##0 kr | Beregnet resultatbasert uttelling etter KDs 2025-satser */


-- ==============================================================================
-- 7. OMSTILLINGSTILTAK & RISIKOSTYRING (ACTION PLAN & RISK)
-- ==============================================================================

[Antall Tiltak] = 
COUNTROWS ( FactAction )
/* Format: #,##0 | Antall registrerte innsparingstiltak i omstillingsplanen */

[Forventet Samlet Tiltakseffekt] = 
SUM ( FactAction[ForventetEffekt] )
/* Format: #,##0 kr | Forventet samlet innsparing fra tiltakskatalogen */

[Realisert Samlet Tiltakseffekt] = 
SUM ( FactAction[RealisertEffekt] )
/* Format: #,##0 kr | Faktisk realisert innsparingseffekt YTD */

[Tiltaksoppnåelse %] = 
DIVIDE ( [Realisert Samlet Tiltakseffekt], [Forventet Samlet Tiltakseffekt], 0 )
/* Format: 0.0% | Realiseringsgrad for vedtatte omstillingstiltak */
