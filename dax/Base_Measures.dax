-- ============================================================
-- BASE FINANCIAL & ACTIVITY MEASURES FOR UIA CONTROLLER MODEL
-- ============================================================

-- ------------------------------------------------------------
-- 01 FAKTISK (ACTUALS / HOVEDBOK - FactGL)
-- ------------------------------------------------------------

Faktisk belop = 
SUM ( FactGL[Belop_signert] )

Faktisk debet = 
SUM ( FactGL[Debet] )

Faktisk kredit = 
SUM ( FactGL[Kredit] )

Faktisk inntekter = 
CALCULATE (
    -[Faktisk belop],
    DimAccount[Kontotype] = "Inntekt"
)

Faktisk kostnader = 
CALCULATE (
    [Faktisk belop],
    DimAccount[Kontotype] = "Kostnad"
)

Faktisk lonnskostnader = 
CALCULATE (
    [Faktisk belop],
    DimAccount[SRS_regnskapslinje] = "Lonnskostnader"
)

Faktisk driftskostnader = 
CALCULATE (
    [Faktisk belop],
    DimAccount[SRS_regnskapslinje] = "Andre driftskostnader"
)

Faktisk avskrivninger = 
CALCULATE (
    [Faktisk belop],
    DimAccount[SRS_regnskapslinje] = "Avskrivninger"
)

Faktisk BOA inntekter = 
CALCULATE (
    [Faktisk inntekter],
    DimProject[Finansieringstype] IN { "Bidrag", "Oppdrag" }
)

Faktisk BOA andel % = 
DIVIDE ( [Faktisk BOA inntekter], [Faktisk inntekter] )

Faktisk lonn per aarsverk = 
DIVIDE ( [Faktisk lonnskostnader], [Aarsverk] )

Faktisk kostnad per SPE60 = 
DIVIDE ( [Faktisk kostnader], [SPE 60] )

Faktisk YTD = 
TOTALYTD ( [Faktisk belop], DimDate[Dato] )

Faktisk inntekter YTD = 
TOTALYTD ( [Faktisk inntekter], DimDate[Dato] )

Faktisk kostnader YTD = 
TOTALYTD ( [Faktisk kostnader], DimDate[Dato] )


-- ------------------------------------------------------------
-- 02 BUDSJETT (BUDGET - FactBudget & BAC)
-- ------------------------------------------------------------

Budsjett = 
SUM ( FactBudget[BudsjettBelop] )

Budsjett inntekter = 
CALCULATE (
    -[Budsjett],
    DimAccount[Kontotype] = "Inntekt"
)

Budsjett kostnader = 
CALCULATE (
    [Budsjett],
    DimAccount[Kontotype] = "Kostnad"
)

Budsjett lonnskostnader = 
CALCULATE (
    [Budsjett],
    DimAccount[SRS_regnskapslinje] = "Lonnskostnader"
)

Budsjett lonn per aarsverk = 
DIVIDE ( [Budsjett lonnskostnader], [Aarsverk] )

Budsjett YTD = 
TOTALYTD ( [Budsjett], DimDate[Dato] )

Aarsbudsjett = 
CALCULATE (
    [Budsjett],
    REMOVEFILTERS ( DimDate[MaanedNr], DimDate[Maaned], DimDate[AarMaaned], DimDate[Dato], DimDate[DatoNokkel] )
)

BAC (Budget at Completion) = 
[Aarsbudsjett]


-- ------------------------------------------------------------
-- 04 AVVIKSANALYSE (VARIANCE ANALYSIS)
-- ------------------------------------------------------------

Avvik mot budsjett = 
[Faktisk belop] - [Budsjett]

Avvik mot budsjett % = 
DIVIDE ( [Avvik mot budsjett], ABS ( [Budsjett] ) )

Avvik inntekter = 
[Faktisk inntekter] - [Budsjett inntekter]

Avvik kostnader = 
[Faktisk kostnader] - [Budsjett kostnader]

Avvik lonnskostnader = 
[Faktisk lonnskostnader] - [Budsjett lonnskostnader]


-- ------------------------------------------------------------
-- 05 BEMANNING & ÅRSVERK (FTE - FactFTE)
-- ------------------------------------------------------------

Aarsverk = 
SUM ( FactFTE[Aarsverk] )

Faglige aarsverk = 
SUM ( FactFTE[FagligeAarsverk] )

Administrative aarsverk = 
CALCULATE (
    [Aarsverk],
    DimPositionGroup[Stillingskategori] = "Teknisk-administrativ"
)

Faglig andel % = 
DIVIDE ( [Faglige aarsverk], [Aarsverk] )

Aarsverk snitt = 
AVERAGEX (
    VALUES ( DimDate[AarMaaned] ),
    [Aarsverk]
)


-- ------------------------------------------------------------
-- 06 STUDIEPOENG & UTDANNINGSPRODUKSJON (FactStudyPoints)
-- ------------------------------------------------------------

Avlagte studiepoeng = 
SUM ( FactStudyPoints[AvlagteStudiepoeng] )

Planlagte studiepoeng = 
SUM ( FactStudyPoints[PlanlagteStudiepoeng] )

SPE 60 = 
SUM ( FactStudyPoints[SPE60] )

Registrerte studenter = 
SUM ( FactStudyPoints[RegistrerteStudenter] )

Gjennomforingsgrad % = 
DIVIDE ( [Avlagte studiepoeng], [Planlagte studiepoeng] )

Studiepoeng per faglige aarsverk = 
DIVIDE ( [Avlagte studiepoeng], [Faglige aarsverk] )

SPE60 per faglige aarsverk = 
DIVIDE ( [SPE 60], [Faglige aarsverk] )

Avlagte studiepoeng YTD = 
TOTALYTD ( [Avlagte studiepoeng], DimDate[Dato] )

SPE 60 YTD = 
TOTALYTD ( [SPE 60], DimDate[Dato] )
