		sourceColumn: DatoNokkel
		summarizeBy: none

	column Organisasjonsnokkel
		dataType: int64
		sourceColumn: Organisasjonsnokkel
		summarizeBy: none

	column Stillingsgruppe
		dataType: string
		sourceColumn: Stillingsgruppe
		summarizeBy: none

	column Aarsverk
		dataType: double
		formatString: #,##0.00
		sourceColumn: Aarsverk
		summarizeBy: sum

	column FagligeAarsverk
		dataType: double
		formatString: #,##0.00
		sourceColumn: FagligeAarsverk
		summarizeBy: sum

	column Scenario
		dataType: string
		sourceColumn: Scenario
