table _Measures
	lineageTag: m0000000-0000-0000-0000-000000000001

	measure Budsjett = SUM ( FactBudget[BudsjettBelop] )
		formatString: #,##0.00
		displayFolder: 01 Okonomi
		lineageTag: e7bad816-2874-45e3-ad9a-8b495256a38b

	measure 'Budsjett YTD' = TOTALYTD ( [Budsjett], DimDate[Dato] )
		formatString: #,##0.00
		displayFolder: 01 Okonomi
		lineageTag: dd4ac9fb-8589-46b9-82f1-99b15513f79c

	measure Aarsbudsjett = CALCULATE ( [Budsjett], REMOVEFILTERS ( DimDate ) )
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 1a5f0a59-9bb1-4cdc-a9ed-165c72ec70ec

	measure 'BAC (Budget at Completion)' = [Aarsbudsjett]
		formatString: #,##0.00
		displayFolder: 06 EVM Prosjekt
		lineageTag: 69bbe1ed-c5bc-4584-81c5-aa65e2ddefdb

	measure 'Forecast etter tiltak' = [Forecast aarsbelop] + [Forventet tiltakseffekt]
		formatString: #,##0.00
		displayFolder: 05 Tiltak
		lineageTag: 3dbbc372-0080-4c36-a097-fe54cc3cee87

	measure 'Valgt forecastversjon' = SELECTEDVALUE ( DimForecastVersion[Versjon], "LE_2026" )
		displayFolder: 02 Forecast
		lineageTag: 6d45ab2d-dd4e-4e85-807d-9c05341231aa

	measure 'Gjeldende forecast' =
			VAR V = [Valgt forecastversjon]
			RETURN
			    CALCULATE (
			        [Forecast],
			        KEEPFILTERS ( DimForecastVersion[Versjon] = V )
			    )
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 1aa71331-ab2a-4297-ba30-93c7f46e4a4c

	measure 'Forecast aarsbelop' = CALCULATE ( [Gjeldende forecast], REMOVEFILTERS ( DimDate ) )
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 5a906364-c348-4e84-8604-087f1ad03f9e

	measure 'EAC (Estimate at Completion)' = [Forecast aarsbelop]
		formatString: #,##0.00
		displayFolder: 06 EVM Prosjekt
		lineageTag: 39f92bde-556e-427f-87ae-f229e161e0d6

	measure 'ETC (Estimate to Complete)' = [Forecast aarsbelop] - TOTALYTD ( [Gjeldende forecast], DimDate[Dato] )
		formatString: #,##0.00
		displayFolder: 06 EVM Prosjekt
		lineageTag: 5aa67d4c-b610-4858-81ea-e67d867fc968

	measure 'Latest Estimate' =
			CALCULATE (
			    [Forecast],
			    REMOVEFILTERS ( DimForecastVersion ),
			    DimForecastVersion[Versjon] = "LE_2026",
			    REMOVEFILTERS ( DimDate )
			)
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 2697e755-6a55-433c-b8bf-77ea5354a87e

	measure 'VAC (Variance at Completion)' = [BAC (Budget at Completion)] - [EAC (Estimate at Completion)]
		formatString: #,##0.00
		displayFolder: 06 EVM Prosjekt
		lineageTag: 64b9052b-4ed4-4300-b1e6-b52c06ec6466

	measure 'VAC %' = DIVIDE ( [VAC (Variance at Completion)], [BAC (Budget at Completion)] )
		formatString: 0.0%
		displayFolder: 06 EVM Prosjekt
		lineageTag: ababc941-a09b-4976-a926-f03b491dcff2

	measure Aarsverk =
			VAR D =
			    MAXX (
			        FILTER ( ALLSELECTED ( DimDate ), CALCULATE ( COUNTROWS ( FactFTE ) ) > 0 ),
			        DimDate[DatoNokkel]
			    )
			RETURN
			    CALCULATE ( SUM ( FactFTE[Aarsverk] ), DimDate[DatoNokkel] = D )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier
		lineageTag: a75c122d-b01d-4c97-8ce4-a344c327fb1f

	measure 'Faglige aarsverk' =
			VAR D =
			    MAXX (
			        FILTER ( ALLSELECTED ( DimDate ), CALCULATE ( COUNTROWS ( FactFTE ) ) > 0 ),
			        DimDate[DatoNokkel]
			    )
			RETURN
			    CALCULATE ( SUM ( FactFTE[FagligeAarsverk] ), DimDate[DatoNokkel] = D )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier
		lineageTag: 76cbf357-a801-4163-a32b-6359d231e0a8

	measure 'Avlagte studiepoeng' = SUM ( FactStudyPoints[AvlagteStudiepoeng] )
		formatString: #,##0.0
		displayFolder: 03 Bemanning & Studier
		lineageTag: 7b57c983-df5b-47bc-a631-4d7659d95ba9

	measure 'Registrerte studenter' =
			VAR D =
			    MAXX (
			        FILTER ( ALLSELECTED ( DimDate ), CALCULATE ( COUNTROWS ( FactStudyPoints ) ) > 0 ),
			        DimDate[DatoNokkel]
			    )
			RETURN
			    CALCULATE ( SUM ( FactStudyPoints[RegistrerteStudenter] ), DimDate[DatoNokkel] = D )
		formatString: #,##0
		displayFolder: 03 Bemanning & Studier
		lineageTag: e2b1d4bf-0e84-4177-b1bb-4fe5a3a79c1c

	measure Forecaststatus =
			VAR AvvikPct = [Forecastavvik %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( AvvikPct ), BLANK (),
			        AvvikPct > 0.05, "Rod",
			        AvvikPct > 0.02, "Gul",
			        AvvikPct < -0.05, "Bla",
			        "Gronn"
			    )
		displayFolder: 07 Status & Farger
		lineageTag: 4abbc4f5-5a2d-479b-8aa1-7db2cbf04a4a

	measure 'Forecaststatus farge' =
			SWITCH (
			    [Forecaststatus],
			    "Rod", "#C00000",
			    "Gul", "#FFC000",
			    "Bla", "#5B9BD5",
			    "Gronn", "#70AD47",
			    "#A6A6A6"
			)
		displayFolder: 07 Status & Farger
		lineageTag: e48cfd17-72c5-4733-aaa1-39c739692e5b

	measure Regnskap = SUM ( FactGL[Belop_signert] )
		formatString: #,##0.00
		displayFolder: 01 Okonomi
		lineageTag: cd81e0be-8e49-4b02-ba12-876e503127cb

	measure Avvik = [Regnskap] - [Budsjett]
		formatString: #,##0.00
		displayFolder: 01 Okonomi
		lineageTag: 8231bd35-cf34-4832-acf0-48699700c4d2

	measure 'Avvik %' = DIVIDE ( [Avvik], ABS ( [Budsjett] ) )
		formatString: 0.0%
		displayFolder: 01 Okonomi
		lineageTag: 8b7a50c6-2546-42fe-bf99-c2bc71a7b523

	measure 'Regnskap YTD' = TOTALYTD ( [Regnskap], DimDate[Dato] )
		formatString: #,##0.00
		displayFolder: 01 Okonomi
		lineageTag: 36975635-7fc8-4832-a028-3c1739782e51

	measure 'Avvik YTD' = [Regnskap YTD] - [Budsjett YTD]
		formatString: #,##0.00
		displayFolder: 01 Okonomi
		lineageTag: a3d56ad0-4688-4fee-844c-cb38d5dfa8bf

	measure Inntekter =
			CALCULATE (
			    -[Regnskap],
			    DimAccount[Kontotype] = "Inntekt"
			)
		formatString: #,##0.00
		displayFolder: 01 Okonomi
		lineageTag: 0c94ae69-59e0-4fd4-a3c2-7df00f8a5549

	measure Kostnader =
			CALCULATE (
			    [Regnskap],
			    DimAccount[Kontotype] = "Kostnad"
			)
		formatString: #,##0.00
		displayFolder: 01 Okonomi
		lineageTag: b2a4a7d5-0ba5-4307-8132-d3d56a6da164

	measure Lonnskostnader =
			CALCULATE (
			    [Regnskap],
			    DimAccount[SRS_regnskapslinje] = "Lonnskostnader"
			)
		formatString: #,##0.00
		displayFolder: 01 Okonomi
		lineageTag: 1e21ab90-63f1-41d9-9476-8a66115b9f19

	measure 'Lonnandel %' = DIVIDE ( [Lonnskostnader], [Kostnader] )
		formatString: 0.0%
		displayFolder: 01 Okonomi
		lineageTag: a7859f9a-a1f4-4f35-9c06-9ec1a3e910d7

	measure Forecast = SUM ( FactForecast[ForecastBelop] )
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 39c5e9e7-91cf-4bab-9aa9-afdc2119d551

	measure Forecastavvik = [Forecast aarsbelop] - [Aarsbudsjett]
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 7d164d83-57bf-4eeb-b616-61d0ffa7b977

	measure 'Forecastavvik %' = DIVIDE ( [Forecastavvik], ABS ( [Aarsbudsjett] ) )
		formatString: 0.0%
		displayFolder: 02 Forecast
		lineageTag: 2cfeadae-df5e-4270-8103-a1872d654cba

	measure 'Forecast confidence %' = AVERAGE ( FactForecast[Sannsynlighet] )
		formatString: 0.0%
		displayFolder: 02 Forecast
		lineageTag: 754d51e5-2ed3-45bc-8c4d-20be1c97c5db

	measure FC1 =
			CALCULATE (
			    [Forecast],
			    REMOVEFILTERS ( DimForecastVersion ),
			    DimForecastVersion[Versjon] = "FC1_2026",
			    REMOVEFILTERS ( DimDate )
			)
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 84ffa505-c993-44a3-aa7a-f9e58741a701

	measure FC2 =
			CALCULATE (
			    [Forecast],
			    REMOVEFILTERS ( DimForecastVersion ),
			    DimForecastVersion[Versjon] = "FC2_2026",
			    REMOVEFILTERS ( DimDate )
			)
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 38b45be2-4c91-439d-8e96-9cf273fb8c33

	measure 'Endring FC2 til LE' = [Latest Estimate] - [FC2]
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 70837838-c5d1-4364-b1ef-52d72adbdf28

	measure 'Forecast lonn' =
			CALCULATE (
			    [Gjeldende forecast],
			    DimAccount[SRS_regnskapslinje] = "Lonnskostnader"
			)
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: ccccb2a9-e6ae-4c14-a4a4-2fce3c804afe

	measure SPE60 = SUM ( FactStudyPoints[SPE60] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier
		lineageTag: 8555adf7-05f4-48e0-bdaf-d3ed28f683a4

	measure 'Studiepoeng maaloppnaelse %' = DIVIDE ( [Avlagte studiepoeng], SUM ( FactStudyPoints[PlanlagteStudiepoeng] ) )
		formatString: 0.0%
		displayFolder: 03 Bemanning & Studier
		lineageTag: 8d57f095-80be-4824-ab80-e5d8f1cbcd2b

	measure 'Studenter per faglig aarsverk' = DIVIDE ( [Registrerte studenter], [Faglige aarsverk] )
		formatString: #,##0.0
		displayFolder: 03 Bemanning & Studier
		lineageTag: 8f43f28b-dec1-4176-90f2-e6c8a869ecbf

	measure 'SPE60 per faglig aarsverk' = DIVIDE ( [SPE60], [Faglige aarsverk] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier
		lineageTag: 3940429e-38d9-49b9-a6ed-b1a1666b62ba

	measure 'Kostnad per student' = DIVIDE ( [Kostnader], [Registrerte studenter] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier
		lineageTag: 67634044-2e7c-4724-a4b0-ba979bf79195

	measure 'Kostnad per SPE60' = DIVIDE ( [Kostnader], [SPE60] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier
		lineageTag: e7d3558b-3868-43ac-83e2-9035a72557e4

	measure 'Lonn per aarsverk' = DIVIDE ( [Lonnskostnader], [Aarsverk] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier
		lineageTag: 9387c73a-2e43-47c1-a3ef-ac4ae38eb967

	measure 'BOA inntekter' =
			CALCULATE (
			    [Inntekter],
			    DimProject[Finansieringstype] IN { "Bidrag", "Oppdrag" }
			)
		formatString: #,##0.00
		displayFolder: 04 BOA
		lineageTag: 24be8f35-e75d-486f-9e12-4e9e51a7eba5

	measure 'NFR inntekter' =
			CALCULATE (
			    [Inntekter],
			    DimProject[Finansieringskilde] = "NFR"
			)
		formatString: #,##0.00
		displayFolder: 04 BOA
		lineageTag: 02364cc7-b369-41a9-b033-09fcc7c1e674

	measure 'EU inntekter' =
			CALCULATE (
			    [Inntekter],
			    DimProject[Finansieringskilde] = "EU"
			)
		formatString: #,##0.00
		displayFolder: 04 BOA
		lineageTag: bc7317bc-0704-4a5f-a3bb-31a0838504d2

	measure 'BOA andel %' = DIVIDE ( [BOA inntekter], [Inntekter] )
		formatString: 0.0%
		displayFolder: 04 BOA
		lineageTag: 1f3abd98-51c2-4783-99f3-5a0503440891

	measure 'BOA per faglig aarsverk' = DIVIDE ( [BOA inntekter], [Faglige aarsverk] )
		formatString: #,##0.00
		displayFolder: 04 BOA
		lineageTag: f7c2df80-6c77-42b7-8466-8c9d7e1f150f

	measure 'Antall tiltak' = DISTINCTCOUNT ( FactAction[TiltakID] )
		formatString: #,##0
		displayFolder: 05 Tiltak
		lineageTag: fb013de1-292c-4948-a186-d8f1c83ba6d5

	measure 'Forventet tiltakseffekt' = SUM ( FactAction[ForventetEffekt] )
		formatString: #,##0.00
		displayFolder: 05 Tiltak
		lineageTag: 6d5b9ef2-01c8-463c-a72a-be27d7aab467

	measure 'Realisert tiltakseffekt' = SUM ( FactAction[RealisertEffekt] )
		formatString: #,##0.00
		displayFolder: 05 Tiltak
		lineageTag: 51d4ef43-46bf-4cae-83d9-1c2cdf1e56f0

	measure 'Tiltak realiseringsgrad %' = DIVIDE ( [Realisert tiltakseffekt], [Forventet tiltakseffekt] )
		formatString: 0.0%
		displayFolder: 05 Tiltak
		lineageTag: 240e9f51-d19b-4d60-8a9c-51bb44aacf27

	measure 'Aapne tiltak' =
			CALCULATE (
			    [Antall tiltak],
			    FactAction[Status] <> "Gjennomfort"
			)
		formatString: #,##0
		displayFolder: 05 Tiltak
		lineageTag: 81f1a8e9-adb0-4cda-b773-314dc84fc892

	measure 'Forsinkede tiltak' =
			CALCULATE (
			    [Antall tiltak],
			    FactAction[Status] = "Forsinket"
			)
		formatString: #,##0
		displayFolder: 05 Tiltak
		lineageTag: 751ebe9c-519e-46f7-ac3f-bb135e56b588

	measure 'Restavvik etter tiltak' = [Forecast etter tiltak] - [Aarsbudsjett]
		formatString: #,##0.00
		displayFolder: 05 Tiltak
		lineageTag: 878c7798-640e-4b18-a25e-64dc1a47119e

	measure 'Tiltaksdekning av avvik %' = DIVIDE ( ABS ( [Forventet tiltakseffekt] ), ABS ( [Forecastavvik] ) )
		formatString: 0.0%
		displayFolder: 05 Tiltak
		lineageTag: ad61beeb-f488-4fe4-b79f-ebab53e3cc2c

	measure 'Avvik YTD %' = DIVIDE ( [Avvik YTD], ABS ( [Budsjett YTD] ) )
		formatString: 0.0%
		displayFolder: 01 Okonomi
		lineageTag: 0b69a003-9cdf-4407-b432-430f9d0ce297

	measure 'Forecast lonnsavvik' = [Forecast lonn] - CALCULATE ( [Aarsbudsjett], DimAccount[SRS_regnskapslinje] = "Lonnskostnader" )
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 0195b5b5-f654-4403-902c-a64160c47c53

	measure 'Absolutt forecastavvik' = ABS ( [Forecastavvik] )
		formatString: #,##0.00
		displayFolder: 02 Forecast
		lineageTag: 04ee47fd-8f2d-468f-973f-75aa9281a813

	column Placeholder
		dataType: string
