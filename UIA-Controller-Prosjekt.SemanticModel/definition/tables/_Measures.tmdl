	measure Forecaststatus =
			VAR AvvikPct = [Forecast mot budsjett %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( AvvikPct ), BLANK (),
			        AvvikPct > 0.05, "Rod",
			        AvvikPct > 0.02, "Gul",
			        AvvikPct < -0.05, "Bla",
			        "Gronn"
			    )
		displayFolder: 08 Status & Farger
		lineageTag: 299243f9-c73f-46a0-8df8-19acd20ff48d

	measure 'Forecaststatus farge' =
			SWITCH (
			    [Forecaststatus],
			    "Rod", "#C00000",
			    "Gul", "#FFC000",
			    "Bla", "#5B9BD5",
			    "Gronn", "#70AD47",
			    "#A6A6A6"
			)
		displayFolder: 08 Status & Farger
		lineageTag: 868241d5-a2d6-44c3-8c7a-59e62c13d847

	column Placeholder
		dataType: string
		isHidden
		lineageTag: acd4ebe8-dcc7-4417-b10c-f6e5ac84b559
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {{"Placeholder"}})
				in
				    Source

