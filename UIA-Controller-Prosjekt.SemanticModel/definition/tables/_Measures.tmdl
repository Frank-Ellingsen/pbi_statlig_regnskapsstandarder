	measure 'Forecast RAG Status' =
			VAR AvvikPct = [Forecastavvik %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( AvvikPct ), BLANK (),
			        AvvikPct > 0.05, "🔴 Rød (>5%)",
			        AvvikPct > 0.02, "🟡 Gul (2-5%)",
			        "🟢 Grønn (<=2%)"
			    )
		displayFolder: 07 Status & Farger
		lineageTag: 34071530-cfc0-455d-b973-272040d1adcd

	measure 'Avvik YTD RAG Status' =
			VAR AvvikPct = [Avvik YTD %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( AvvikPct ), BLANK (),
			        AvvikPct > 0.05, "🔴 Rød (>5%)",
			        AvvikPct > 0.02, "🟡 Gul (2-5%)",
			        "🟢 Grønn (<=2%)"
			    )
		displayFolder: 07 Status & Farger
		lineageTag: 941e5966-1d8d-4210-8a17-aad89e2bb293

	measure 'Tiltak RAG Status' =
			VAR S = SELECTEDVALUE ( FactAction[Status] )
			RETURN
			    SWITCH (
			        S,
			        "Gjennomfort", "🟢 Gjennomført",
			        "Pagar", "🟡 Pågår",
			        "Forsinket", "🔴 Forsinket",
			        "⚪ Planlagt"
			    )
		displayFolder: 07 Status & Farger
		lineageTag: 09e66d20-06e0-4c39-b526-bc9cf5dadc69

	measure 'Studiepoeng RAG Status' =
			VAR M = [Studiepoeng maaloppnaelse %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( M ), BLANK (),
			        M >= 0.90, "🟢 Mål nådd (>=90%)",
			        M >= 0.80, "🟡 Moderat (80-90%)",
			        "🔴 Lav (<80%)"
			    )
		displayFolder: 07 Status & Farger
		lineageTag: e971cedc-889a-4198-96f5-18a8b725f3e6

	measure 'EVM Sluttavvik RAG Status' =
			VAR V = [VAC %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( V ), BLANK (),
			        V >= 0, "🟢 Under budsjett",
			        V >= -0.05, "🟡 Moderat overskridelse",
			        "🔴 Kritisk overskridelse"
			    )
		displayFolder: 07 Status & Farger
		lineageTag: 5a5ce3ca-96a2-42a4-994f-0e3ba9cdd4a5

	measure 'Antall rode institutter' =
