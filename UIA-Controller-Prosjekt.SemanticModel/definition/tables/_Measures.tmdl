table _Measures
	lineageTag: m0000000-0000-0000-0000-000000000001

	measure Regnskap = SUM ( FactGL[Belop_signert] )
		formatString: #,##0.00
		displayFolder: 01 Okonomi

	measure Budsjett = SUM ( FactBudget[BudsjettBelop] )
		formatString: #,##0.00
		displayFolder: 01 Okonomi

	measure Avvik = [Regnskap] - [Budsjett]
		formatString: #,##0.00
		displayFolder: 01 Okonomi

	measure 'Avvik %' = DIVIDE ( [Avvik], ABS ( [Budsjett] ) )
		formatString: 0.0%
		displayFolder: 01 Okonomi

	measure 'Regnskap YTD' = TOTALYTD ( [Regnskap], DimDate[Dato] )
		formatString: #,##0.00
		displayFolder: 01 Okonomi

	measure 'Budsjett YTD' = TOTALYTD ( [Budsjett], DimDate[Dato] )
		formatString: #,##0.00
		displayFolder: 01 Okonomi

	measure 'Avvik YTD' = [Regnskap YTD] - [Budsjett YTD]
		formatString: #,##0.00
		displayFolder: 01 Okonomi

	measure Inntekter = ```
		CALCULATE (
		    -[Regnskap],
		    DimAccount[Kontotype] = "Inntekt"
		)
		```
		formatString: #,##0.00
		displayFolder: 01 Okonomi

	measure Kostnader = ```
		CALCULATE (
		    [Regnskap],
		    DimAccount[Kontotype] = "Kostnad"
		)
		```
		formatString: #,##0.00
		displayFolder: 01 Okonomi

	measure Lonnskostnader = ```
		CALCULATE (
		    [Regnskap],
		    DimAccount[SRS_regnskapslinje] = "Lonnskostnader"
		)
		```
		formatString: #,##0.00
		displayFolder: 01 Okonomi

	measure 'Lonnandel %' = DIVIDE ( [Lonnskostnader], [Kostnader] )
		formatString: 0.0%
		displayFolder: 01 Okonomi

	measure Forecast = SUM ( FactForecast[ForecastBelop] )
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure 'Valgt forecastversjon' = SELECTEDVALUE ( DimForecastVersion[Versjon], "LE_2026" )
		displayFolder: 02 Forecast

	measure 'Gjeldende forecast' = ```
		VAR V = [Valgt forecastversjon]
		RETURN
		    CALCULATE (
		        [Forecast],
		        KEEPFILTERS ( DimForecastVersion[Versjon] = V )
		    )
		```
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure Aarsbudsjett = CALCULATE ( [Budsjett], REMOVEFILTERS ( DimDate ) )
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure 'Forecast aarsbelop' = CALCULATE ( [Gjeldende forecast], REMOVEFILTERS ( DimDate ) )
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure Forecastavvik = [Forecast aarsbelop] - [Aarsbudsjett]
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure 'Forecastavvik %' = DIVIDE ( [Forecastavvik], ABS ( [Aarsbudsjett] ) )
		formatString: 0.0%
		displayFolder: 02 Forecast

	measure 'Forecast confidence %' = AVERAGE ( FactForecast[Sannsynlighet] )
		formatString: 0.0%
		displayFolder: 02 Forecast

	measure FC1 = ```
		CALCULATE (
		    [Forecast],
		    REMOVEFILTERS ( DimForecastVersion ),
		    DimForecastVersion[Versjon] = "FC1_2026",
		    REMOVEFILTERS ( DimDate )
		)
		```
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure FC2 = ```
		CALCULATE (
		    [Forecast],
		    REMOVEFILTERS ( DimForecastVersion ),
		    DimForecastVersion[Versjon] = "FC2_2026",
		    REMOVEFILTERS ( DimDate )
		)
		```
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure 'Latest Estimate' = ```
		CALCULATE (
		    [Forecast],
		    REMOVEFILTERS ( DimForecastVersion ),
		    DimForecastVersion[Versjon] = "LE_2026",
		    REMOVEFILTERS ( DimDate )
		)
		```
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure 'Endring FC2 til LE' = [Latest Estimate] - [FC2]
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure 'Forecast lonn' = ```
		CALCULATE (
		    [Gjeldende forecast],
		    DimAccount[SRS_regnskapslinje] = "Lonnskostnader"
		)
		```
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure Aarsverk = ```
		VAR D =
		    MAXX (
		        FILTER ( ALLSELECTED ( DimDate ), CALCULATE ( COUNTROWS ( FactFTE ) ) > 0 ),
		        DimDate[DatoNokkel]
		    )
		RETURN
		    CALCULATE ( SUM ( FactFTE[Aarsverk] ), DimDate[DatoNokkel] = D )
		```
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier

	measure 'Faglige aarsverk' = ```
		VAR D =
		    MAXX (
		        FILTER ( ALLSELECTED ( DimDate ), CALCULATE ( COUNTROWS ( FactFTE ) ) > 0 ),
		        DimDate[DatoNokkel]
		    )
		RETURN
		    CALCULATE ( SUM ( FactFTE[FagligeAarsverk] ), DimDate[DatoNokkel] = D )
		```
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier

	measure 'Registrerte studenter' = ```
		VAR D =
		    MAXX (
		        FILTER ( ALLSELECTED ( DimDate ), CALCULATE ( COUNTROWS ( FactStudyPoints ) ) > 0 ),
		        DimDate[DatoNokkel]
		    )
		RETURN
		    CALCULATE ( SUM ( FactStudyPoints[RegistrerteStudenter] ), DimDate[DatoNokkel] = D )
		```
		formatString: #,##0
		displayFolder: 03 Bemanning & Studier

	measure 'Avlagte studiepoeng' = SUM ( FactStudyPoints[AvlagteStudiepoeng] )
		formatString: #,##0.0
		displayFolder: 03 Bemanning & Studier

	measure SPE60 = SUM ( FactStudyPoints[SPE60] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier

	measure 'Studiepoeng maaloppnaelse %' = DIVIDE ( [Avlagte studiepoeng], SUM ( FactStudyPoints[PlanlagteStudiepoeng] ) )
		formatString: 0.0%
		displayFolder: 03 Bemanning & Studier

	measure 'Studenter per faglig aarsverk' = DIVIDE ( [Registrerte studenter], [Faglige aarsverk] )
		formatString: #,##0.0
		displayFolder: 03 Bemanning & Studier

	measure 'SPE60 per faglig aarsverk' = DIVIDE ( [SPE60], [Faglige aarsverk] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier

	measure 'Kostnad per student' = DIVIDE ( [Kostnader], [Registrerte studenter] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier

	measure 'Kostnad per SPE60' = DIVIDE ( [Kostnader], [SPE60] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier

	measure 'Lonn per aarsverk' = DIVIDE ( [Lonnskostnader], [Aarsverk] )
		formatString: #,##0.00
		displayFolder: 03 Bemanning & Studier

	measure 'BOA inntekter' = ```
		CALCULATE (
		    [Inntekter],
		    DimProject[Finansieringstype] IN { "Bidrag", "Oppdrag" }
		)
		```
		formatString: #,##0.00
		displayFolder: 04 BOA

	measure 'NFR inntekter' = ```
		CALCULATE (
		    [Inntekter],
		    DimProject[Finansieringskilde] = "NFR"
		)
		```
		formatString: #,##0.00
		displayFolder: 04 BOA

	measure 'EU inntekter' = ```
		CALCULATE (
		    [Inntekter],
		    DimProject[Finansieringskilde] = "EU"
		)
		```
		formatString: #,##0.00
		displayFolder: 04 BOA

	measure 'BOA andel %' = DIVIDE ( [BOA inntekter], [Inntekter] )
		formatString: 0.0%
		displayFolder: 04 BOA

	measure 'BOA per faglig aarsverk' = DIVIDE ( [BOA inntekter], [Faglige aarsverk] )
		formatString: #,##0.00
		displayFolder: 04 BOA

	measure 'Antall tiltak' = DISTINCTCOUNT ( FactAction[TiltakID] )
		formatString: #,##0
		displayFolder: 05 Tiltak

	measure 'Forventet tiltakseffekt' = SUM ( FactAction[ForventetEffekt] )
		formatString: #,##0.00
		displayFolder: 05 Tiltak

	measure 'Realisert tiltakseffekt' = SUM ( FactAction[RealisertEffekt] )
		formatString: #,##0.00
		displayFolder: 05 Tiltak

	measure 'Tiltak realiseringsgrad %' = DIVIDE ( [Realisert tiltakseffekt], [Forventet tiltakseffekt] )
		formatString: 0.0%
		displayFolder: 05 Tiltak

	measure 'Aapne tiltak' = ```
		CALCULATE (
		    [Antall tiltak],
		    FactAction[Status] <> "Gjennomfort"
		)
		```
		formatString: #,##0
		displayFolder: 05 Tiltak

	measure 'Forsinkede tiltak' = ```
		CALCULATE (
		    [Antall tiltak],
		    FactAction[Status] = "Forsinket"
		)
		```
		formatString: #,##0
		displayFolder: 05 Tiltak

	measure 'Forecast etter tiltak' = [Forecast aarsbelop] + [Forventet tiltakseffekt]
		formatString: #,##0.00
		displayFolder: 05 Tiltak

	measure 'Restavvik etter tiltak' = [Forecast etter tiltak] - [Aarsbudsjett]
		formatString: #,##0.00
		displayFolder: 05 Tiltak

	measure 'Tiltaksdekning av avvik %' = DIVIDE ( ABS ( [Forventet tiltakseffekt] ), ABS ( [Forecastavvik] ) )
		formatString: 0.0%
		displayFolder: 05 Tiltak

	measure 'BAC (Budget at Completion)' = [Aarsbudsjett]
		formatString: #,##0.00
		displayFolder: 06 EVM Prosjekt

	measure 'EAC (Estimate at Completion)' = [Forecast aarsbelop]
		formatString: #,##0.00
		displayFolder: 06 EVM Prosjekt

	measure 'ETC (Estimate to Complete)' = [Forecast aarsbelop] - TOTALYTD ( [Gjeldende forecast], DimDate[Dato] )
		formatString: #,##0.00
		displayFolder: 06 EVM Prosjekt

	measure 'VAC (Variance at Completion)' = [BAC (Budget at Completion)] - [EAC (Estimate at Completion)]
		formatString: #,##0.00
		displayFolder: 06 EVM Prosjekt

	measure 'VAC %' = DIVIDE ( [VAC (Variance at Completion)], [BAC (Budget at Completion)] )
		formatString: 0.0%
		displayFolder: 06 EVM Prosjekt

	measure Forecaststatus = ```
		VAR AvvikPct = [Forecastavvik %]
		RETURN
		    SWITCH (
		        TRUE (),
		        ISBLANK ( AvvikPct ), BLANK (),
		        AvvikPct > 0.05, "Rod",
		        AvvikPct > 0.02, "Gul",
		        AvvikPct < -0.05, "Bla",
		        "Gronn"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'Forecaststatus farge' = ```
		SWITCH (
		    [Forecaststatus],
		    "Rod", "#C00000",
		    "Gul", "#FFC000",
		    "Bla", "#5B9BD5",
		    "Gronn", "#70AD47",
		    "#A6A6A6"
		)
		```
		displayFolder: 07 Status & Farger

	measure 'Forecast RAG Status' = ```
		VAR AvvikPct = [Forecastavvik %]
		RETURN
		    SWITCH (
		        TRUE (),
		        ISBLANK ( AvvikPct ), BLANK (),
		        AvvikPct > 0.05, "🔴 Rød (>5%)",
		        AvvikPct > 0.02, "🟡 Gul (2-5%)",
		        "🟢 Grønn (<=2%)"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'Avvik YTD RAG Status' = ```
		VAR AvvikPct = [Avvik YTD %]
		RETURN
		    SWITCH (
		        TRUE (),
		        ISBLANK ( AvvikPct ), BLANK (),
		        AvvikPct > 0.05, "🔴 Rød (>5%)",
		        AvvikPct > 0.02, "🟡 Gul (2-5%)",
		        "🟢 Grønn (<=2%)"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'Tiltak RAG Status' = ```
		VAR S = SELECTEDVALUE ( FactAction[Status] )
		RETURN
		    SWITCH (
		        S,
		        "Gjennomfort", "🟢 Gjennomført",
		        "Pagar", "🟡 Pågår",
		        "Forsinket", "🔴 Forsinket",
		        "⚪ Planlagt"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'Studiepoeng RAG Status' = ```
		VAR M = [Studiepoeng maaloppnaelse %]
		RETURN
		    SWITCH (
		        TRUE (),
		        ISBLANK ( M ), BLANK (),
		        M >= 0.90, "🟢 Mål nådd (>=90%)",
		        M >= 0.80, "🟡 Moderat (80-90%)",
		        "🔴 Lav (<80%)"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'EVM Sluttavvik RAG Status' = ```
		VAR V = [VAC %]
		RETURN
		    SWITCH (
		        TRUE (),
		        ISBLANK ( V ), BLANK (),
		        V >= 0, "🟢 Under budsjett",
		        V >= -0.05, "🟡 Moderat overskridelse",
		        "🔴 Kritisk overskridelse"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'Antall rode institutter' = ```
		CALCULATE (
		    DISTINCTCOUNT ( DimOrganization[Instituttnavn] ),
		    FILTER (
		        VALUES ( DimOrganization[Instituttnavn] ),
		        [Forecastavvik %] > 0.05
		    )
		)
		```
		formatString: #,##0
		displayFolder: 07 Status & Farger

	measure 'Avvik RAG farge' = ```
		VAR AvvikPct = [Avvik YTD %]
		RETURN
		    SWITCH (
		        TRUE (),
		        ISBLANK ( AvvikPct ), "#A6A6A6",
		        AvvikPct > 0.05, "#C00000",
		        AvvikPct > 0.02, "#FFC000",
		        "#70AD47"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'Tiltak RAG farge' = ```
		VAR S = SELECTEDVALUE ( FactAction[Status] )
		RETURN
		    SWITCH (
		        S,
		        "Gjennomfort", "#70AD47",
		        "Pagar", "#FFC000",
		        "Forsinket", "#C00000",
		        "#A6A6A6"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'Studiepoeng RAG farge' = ```
		VAR M = [Studiepoeng maaloppnaelse %]
		RETURN
		    SWITCH (
		        TRUE (),
		        ISBLANK ( M ), "#A6A6A6",
		        M >= 0.90, "#70AD47",
		        M >= 0.80, "#FFC000",
		        "#C00000"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'EVM Sluttavvik RAG farge' = ```
		VAR V = [VAC %]
		RETURN
		    SWITCH (
		        TRUE (),
		        ISBLANK ( V ), "#A6A6A6",
		        V >= 0, "#70AD47",
		        V >= -0.05, "#FFC000",
		        "#C00000"
		    )
		```
		displayFolder: 07 Status & Farger

	measure 'Avvik YTD %' = DIVIDE ( [Avvik YTD], ABS ( [Budsjett YTD] ) )
		formatString: 0.0%
		displayFolder: 01 Okonomi

	measure 'Forecast lonnsavvik' = [Forecast lonn] - CALCULATE ( [Aarsbudsjett], DimAccount[SRS_regnskapslinje] = "Lonnskostnader" )
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure 'Absolutt forecastavvik' = ABS ( [Forecastavvik] )
		formatString: #,##0.00
		displayFolder: 02 Forecast

	measure 'Antall begreper' = COUNTROWS ( DimGlossary )
		formatString: #,##0
		displayFolder: 09 Begrepskatalog

	measure 'Antall begrepskategorier' = DISTINCTCOUNT ( DimGlossary[Kategori] )
		formatString: #,##0
		displayFolder: 09 Begrepskatalog

	measure 'Statsbevilgning basis' = ```
		CALCULATE (
		    -[Budsjett],
		    REMOVEFILTERS ( DimDate ),
		    DimAccount[Konto] = 3900
		)
		```
		formatString: #,##0.00
		displayFolder: 10 Regulatorisk & Veileder

	measure 'Maks tillatt reserve 5%' = [Statsbevilgning basis] * 0.05
		formatString: #,##0.00
		displayFolder: 10 Regulatorisk & Veileder

	measure 'Beregnet avsetningsandel %' = DIVIDE ( ABS ( [Avvik YTD] ), [Statsbevilgning basis] )
		formatString: 0.000%
		displayFolder: 10 Regulatorisk & Veileder

	measure '5 %-regel Status' = ```
		IF (
		    [Beregnet avsetningsandel %] <= 0.05,
		    "🟢 Overholdt (<=5%)",
		    "🔴 Overskredet (>5%)"
		)
		```
		displayFolder: 10 Regulatorisk & Veileder

	measure 'KD 2025 SPE Kat 1 Sats' = 54550.0
		formatString: #,##0
		displayFolder: 10 Regulatorisk & Veileder

	measure 'KD 2025 SPE Kat 2 Sats' = 81800.0
		formatString: #,##0
		displayFolder: 10 Regulatorisk & Veileder

	measure 'KD 2025 SPE Kat 3 Sats' = 190900.0
		formatString: #,##0
		displayFolder: 10 Regulatorisk & Veileder

	measure 'SRS 1 Driftsinntekter' = [Inntekter]
		formatString: #,##0.00
		displayFolder: 10 Regulatorisk & Veileder

	measure 'SRS 1 Driftskostnader' = [Kostnader]
		formatString: #,##0.00
		displayFolder: 10 Regulatorisk & Veileder

	measure 'SRS 1 Netto driftsresultat' = [Kostnader] - [Inntekter]
		formatString: #,##0.00
		displayFolder: 10 Regulatorisk & Veileder

	measure 'SRS 10 Bidragsinntekter' = ```
		CALCULATE (
		    [Inntekter],
		    DimProject[Finansieringstype] = "Bidrag"
		)
		```
		formatString: #,##0.00
		displayFolder: 10 Regulatorisk & Veileder

	measure 'SRS 9 Oppdragsinntekter' = ```
		CALCULATE (
		    [Inntekter],
		    DimProject[Finansieringstype] = "Oppdrag"
		)
		```
		formatString: #,##0.00
		displayFolder: 10 Regulatorisk & Veileder

	measure 'SRS 17 Avskrivninger' = ```
		CALCULATE (
		    [Regnskap],
		    DimAccount[SRS_regnskapslinje] = "Av- og nedskrivninger"
		)
		```
		formatString: #,##0.00
		displayFolder: 10 Regulatorisk & Veileder

	column Placeholder
		dataType: string
		isHidden
		lineageTag: m0000000-0000-0000-0000-000000000099
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {{"Placeholder"}})
				in
				    Source
